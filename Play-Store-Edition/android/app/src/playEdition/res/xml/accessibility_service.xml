<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately minimal. FocusBro needs the foreground package name and nothing
  else, so it does not request canRetrieveWindowContent and cannot read what is
  on screen. flagDefault keeps the footprint small; typeWindowStateChanged is the
  only event it acts on.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="false" android:isAccessibilityTool="false"
    android:notificationTimeout="100"
    android:description="@string/accessibility_description_play" />
